[node name="V12Carbine" type="Node3D"]
script = ExtResource("1_carbine")

[node name="RecoilPivot" type="Node3D" parent="."]

[node name="Model" type="Node3D" parent="RecoilPivot"]

[node name="Muzzle" type="Marker3D" parent="RecoilPivot"]
position = Vector3(0, 0, -1.28)

[node name="EjectionPort" type="Marker3D" parent="RecoilPivot"]
# 총열 앞이 아닌 리시버 오른쪽의 탄피 배출구입니다. 월드 탄피는 이 Marker의
# 실제 전역 좌표에서 생성하므로 정조준/반동 자세에서도 총 옆에서 나옵니다.
position = Vector3(0.19, 0.055, -0.12)

[node name="MuzzleVisual" type="Node3D" parent="RecoilPivot"]
position = Vector3(0, 0, -1.28)

[node name="MuzzleSmoke" type="Node3D" parent="RecoilPivot"]
position = Vector3(0, 0, -1.36)

[node name="MuzzleFlash" type="OmniLight3D" parent="RecoilPivot"]
position = Vector3(0, 0, -1.28)
light_color = Color(1, 0.82, 0.6, 1)
# 총구 바로 앞만 밝게 하는 수준을 넘어, 실내의 낮은 천장/바닥에도 순간적인
# 주황빛이 닿도록 유효 범위를 늘립니다. 발사 때만 켜져 상시 비용은 없습니다.
omni_range = 7.0
omni_attenuation = 0.85
shadow_enabled = false

[node name="FireAudio" type="AudioStreamPlayer" parent="."]
stream = ExtResource("3_gunshot")
# 0.09초 연사에서 앞 총성이 끝나기 전에 다음 총성이 시작되어도 잘리지 않게 합니다.
# 일곱 번째 동시 음성이 생기면 가장 오래된 소리부터 교체됩니다.
max_polyphony = 6
# Audacity 원본의 최대 레벨을 알 수 없는 상태이므로 처음에는 여유를 두고 시작합니다.
# 실제 플레이에서 작으면 올리되, 연사 시 찢어지는 소리가 나면 더 낮춥니다.
volume_db = -5.0

[node name="MechanicalAudio" type="AudioStreamPlayer" parent="."]
stream = ExtResource("4_mechanical")
# 연사 중 앞 기계음의 짧은 잔향을 갑자기 끊지 않되, 총성보다 동시 음성 수는 낮춥니다.
max_polyphony = 4
volume_db = -8.0

[node name="DryFireAudio" type="AudioStreamPlayer" parent="."]

[node name="WeaponController" type="Node" parent="."]
script = ExtResource("2_controller")
